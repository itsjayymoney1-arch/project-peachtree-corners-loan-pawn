# ====================================================================
# PEACHTREE CORNERS LOAN & PAWN — THE VAULT
# Environment Variables & Provider Configuration Guide
# ====================================================================
# NOTICE: NEVER commit real production secrets to version control.
# Copy this file to .env.local for local development.

# --------------------------------------------------------------------
# 1. APPLICATION & STORE PROFILE
# --------------------------------------------------------------------
VITE_APP_NAME="Peachtree Corners Loan & Pawn"
VITE_STORE_ADDRESS="7040 Jimmy Carter Boulevard, Suite 4, Peachtree Corners, GA 30092"
VITE_STORE_PHONE="(678) 691-1692"
VITE_STORE_HOURS="Mon-Sat 9:30 AM - 6:00 PM"
VITE_STORE_WEBSITE="https://pawnshopnorcross.com"
VITE_DEFAULT_GA_SALES_TAX_RATE=0.06

# --------------------------------------------------------------------
# 2. MANAGED BACKEND & DATABASE (SUPABASE / POSTGRESQL)
# --------------------------------------------------------------------
# Create project at https://supabase.com and execute supabase_schema.sql
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...public-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...privileged-secret-key-server-only

# --------------------------------------------------------------------
# 3. PAYMENT GATEWAY ADAPTER (SQUARE / STRIPE)
# --------------------------------------------------------------------
# Pawn and retail merchandise requires underwriting approval.
# Initially defaults to demonstration sandbox simulation mode.
VITE_PAYMENT_ENVIRONMENT=sandbox # "sandbox" or "production"
VITE_PAYMENT_PROVIDER=square # "square" or "stripe"

# Square Configuration:
VITE_SQUARE_APPLICATION_ID=sandbox-sq0idb-your-app-id
VITE_SQUARE_LOCATION_ID=L_YOUR_LOCATION_ID
SQUARE_ACCESS_TOKEN=EAAAExxxxxxxxxxxxxxxxxxxxx # Server-side only

# Stripe Alternative Configuration:
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_51xxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_51xxxxxxxxxxxxxxx # Server-side only
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxx # Server-side only

# --------------------------------------------------------------------
# 4. TRANSACTIONAL & MARKETING EMAIL (RESEND / SENDGRID)
# --------------------------------------------------------------------
EMAIL_PROVIDER=resend # "resend" or "sendgrid"
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS="orders@pawnshopnorcross.com"
EMAIL_FROM_NAME="Peachtree Corners Loan & Pawn"
EMAIL_REPLY_TO="service@pawnshopnorcross.com"

# --------------------------------------------------------------------
# 5. BUSINESS SMS MESSAGING (TWILIO / APPROVED CARRIER)
# --------------------------------------------------------------------
# Requires A2P 10DLC campaign registration for promotional texting.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER="+16786911692"

# --------------------------------------------------------------------
# 6. VISION AI PRODUCT INTAKE SERVICE (SMART INTAKE)
# --------------------------------------------------------------------
# Powers Mode 2 Quick Add AI image extraction heuristics
AI_VISION_PROVIDER=openai # "openai" or "google_vision"
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxx # Server-side only

# --------------------------------------------------------------------
# 7. PRIMARY OWNER BOOTSTRAP CREDENTIALS (FIRST SETUP ONLY)
# --------------------------------------------------------------------
INITIAL_OWNER_EMAIL="owner@pawnshopnorcross.com"
INITIAL_OWNER_TEMP_TOKEN="token_bootstrap_pc_vault_2026"
